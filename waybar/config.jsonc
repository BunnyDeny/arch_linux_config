{
  "layer": "top",
  // 模块的最小需求就是 44；写更小的值会被忽略并每次产生警告
  "height": 44,
  //"width": 1000,
  // waybar 0.15.0 里没有 hyprland/mode 这个模块，正确名字是 hyprland/submap
  "modules-left": ["custom/arch", "hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["clock"],
  "modules-right": [
    "cpu",
    "memory",
    "pulseaudio",
    "network",
    "custom/notification"
  ],
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a, %d %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#f5c2e7'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'><b>{}</b></span>",
        "weeks": "<span color='#94e2d5'><b>W{}</b></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>",
      },
    },
  },

  "custom/arch": {
    "format": "󰣇",
    "tooltip": "Power Menu",
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml",
    "menu-actions": {
      "shutdown": "poweroff",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate"
    },
  },

// mako 方案：swaync-client 那套流式 JSON 协议 mako 没有，
// 改为轮询 notification.sh（由它调 makoctl 组装 waybar 需要的 JSON）
"custom/notification": {
  "tooltip": false,
  "format": "{icon}",
  "format-icons": {
    "none": "󰂚",
    "notification": "󱅫",
    "dnd-none": "󰂚",
    "dnd-notification": "󱅫"
  },
  "return-type": "json",
  "interval": 1,
  "exec": "$HOME/.config/waybar/notification.sh",
  "on-click": "makoctl dismiss --all",
  "on-click-right": "makoctl mode -t do-not-disturb",
  "on-click-middle": "makoctl restore"
},

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": " Muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["󰝟", "󰝞", "󰕿", "󰖀", "󰕾", ""],
    },
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"],
  },
  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": true,
  },
  "memory": {
    "interval": 2,
    "format": " {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G used",
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "{icon} {essid} ({signalStrength}%)",
    "format-ethernet": "󰈀 {ipaddr}/{cidr}",
    "format-disconnected": "󰖪 Disconnected",
    "format-icons": {
      "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
      "ethernet": "󰈀",
      "disconnected": "󰖪",
    },
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{icon} {essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "󰈀 {ifname}\n{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
  },
  "hyprland/workspaces": {
    // 显示工作区编号，不再靠"从左往右第几个图标"去数
    "format": "{id}",
    // 每条 bar 只渲染归属自己那块屏的工作区（这是默认值，显式写出表明意图）
    "all-outputs": false,
    // 点击时在当前显示器打开，避免工作区在两块屏之间漂移
    "move-to-monitor": true,
    "on-click": "activate",
    // 若想把 format 改回带图标的形式（如 "{id} {icon}"），下面这几项才会生效。
    // visible = "在另一块屏上可见但不活跃"的工作区，不定义它就会和空占位长得一样。
    "format-icons": {
      "active": "󰮯",
      "visible": "󰮯",
      "default": "󰊠",
    },
  },
}
